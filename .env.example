# Garmin Connect (cyberjunky/python-garminconnect)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# intervals.icu — REST API. **Required, not optional.** Since 12-08-2026 this
# is a complete substitute for Garmin, not just the cross-check: activities,
# per-sample streams, and the HRV/sleep/resting-HR that §6 C2 spends. A session
# without Garmin credentials runs entirely on these two values.
#
# It is also the safer credential of the two, which is the point: a scoped key
# designed to be pasted into third-party tools, revocable on its own without
# touching the watch, and unable to reach back into Garmin.
#
# Auth scheme is verified against live docs in src/mc/intervals.py, not assumed here.
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# Optional — the private state repo holding log/, out/, data/ and
# context/overrides.md. Unset, all of that lives in this checkout and nothing
# changes. Set, this repo stays code-only and personal data physically cannot
# be committed here. See github.com/MatteoPS/marathon-2026-state.
# MC_STATE_DIR=~/marathon-2026-state

# Optional — set to `off` to disable the git side of the writer guard: the
# behind-check, the lease commit/push, and the state commit. The lease still
# applies locally. For a plain single-machine checkout that wants no
# per-ritual commits. Anything else (including unset) leaves the guard on
# whenever STATE_ROOT is a git repo.
#
# This replaced an earlier gate on "is MC_STATE_DIR set", which was a proxy for
# the wrong thing and failed open: with code and state in ONE repo the guard
# silently did nothing at all. The files it protects are whole-file rewrites
# wherever they live.
# MC_STATE_GIT=off

# Optional — which device this is. Written into the writer lease and stamped
# on every state commit as a `Device:` trailer, so "which machine wrote this
# day?" is answerable from the history alone. Defaults to the hostname; set it
# explicitly on any machine whose hostname isn't obvious in a commit log.
# MC_DEVICE=laptop

# Optional — the timezone the *training day* is in. Not a display setting: it
# decides which day `mc log`, `mc propose`, `mc check` and `mc tidy` believe it
# is. Defaults to America/New_York (home, and where the race is), which is what
# makes a cloud container running on UTC still agree with the athlete — its own
# clock ticks into tomorrow at 20:00 Eastern, and `mc tidy` deleted a live
# out/today.md that way on 24-08-2026.
#
# Set it to where you actually are when that changes for more than a day:
# MC_TZ=Europe/Rome    # the Italy block, 10-09 to 30-09
# MC_TZ=America/New_York

# Optional — how long a writer lease stays valid, in minutes (default 120).
# A ritual abandoned half-way on a phone that then went flat must not lock the
# other device out of tomorrow. 0 disables the lease entirely.
# MC_LEASE_TTL_MIN=120

# Optional — weather (Open-Meteo). No API key exists for this; the only thing
# that leaves the machine is one coordinate pair, rounded to 2 decimal places
# (~1.1 km), which is finer than Open-Meteo's own model grid anyway. One HTTP
# call per `mc sync`, to a different provider than Garmin.
#
# Location is taken from the most recent GPS-bearing activity in the Garmin
# cache, so it follows you to Italy in weeks 8-9 on its own. Set LAT/LON only
# to override that — e.g. to forecast for the city rather than for wherever
# you started running, or when a stretch of indoor sessions leaves no recent
# fix. When set it *wins*, so it will keep reporting home weather after a
# flight; `mc weather` prints which source it used on every run.
# MC_WEATHER_LAT=40.80
# MC_WEATHER_LON=-73.96

# Optional — display unit for temperatures. Fahrenheit by default, matching
# the plan's imperial convention and the race's location. Worth flipping to
# celsius for the Italy block. Thresholds are unaffected: Fahrenheit is
# canonical internally and this is a display conversion only.
# MC_TEMP_UNIT=celsius

# Optional — set to `off` to disable the weather call entirely.
# MC_WEATHER=off

# Optional — where `mc render --all` copies out/*.html and out/today.md.
# A plain local directory. If it happens to sit inside a folder your cloud
# client already syncs (iCloud Drive, Dropbox, Drive), that client carries it
# to your phone — mc itself makes no network call and holds no cloud
# credentials. Unset = export off.
# MC_EXPORT_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/marathon
